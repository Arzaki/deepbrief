# DeepBrief — copy to .env and fill in
# Never commit real keys.

# LLM provider: groq | openai | gemini | mock
LLM_PROVIDER=groq
# Generator models (read from config, not hardcoded in logic)
AGENT_MODEL=
CHEAP_MODEL=
JUDGE_PROVIDER=mock
JUDGE_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Search
TAVILY_API_KEY=
# Budgets / run config
TEMPERATURE=0.0
SEED=42
MAX_LLM_CALLS=30
MAX_TOOL_CALLS=30
MAX_TOKENS=60000
MAX_WALL_SECONDS=600
MAX_REVISIONS=2
CACHE_ENABLED=true
CACHE_DB=./.cache/deepbrief.sqlite
TRACE_DIR=./traces
PROMPT_VERSION=v1
