# DeepBrief — copy to .env and fill in
# Never commit real keys.

# LLM provider: groq | openai | gemini | mock
LLM_PROVIDER=groq
# Generator models (read from config, not hardcoded in logic)
# Leave blank for tested defaults. On 404 model_not_found (providers retire IDs),
# run: uv run python scripts/check_models.py and paste a live ID here.
AGENT_MODEL=
CHEAP_MODEL=
JUDGE_PROVIDER=mock
JUDGE_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Search
TAVILY_API_KEY=
# Budgets / run config
TEMPERATURE=0.0
SEED=42
# Max output tokens per LLM request. Lower this if you see
# "Request too large ... OTPM" 429 errors (free tiers cap this, e.g. 1000).
LLM_MAX_TOKENS=1000
MAX_LLM_CALLS=30
MAX_TOOL_CALLS=30
MAX_TOKENS=60000
MAX_WALL_SECONDS=600
MAX_REVISIONS=2
CACHE_ENABLED=true
CACHE_DB=./.cache/deepbrief.sqlite
TRACE_DIR=./traces
PROMPT_VERSION=v1
