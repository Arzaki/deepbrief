# DeepBrief — copy to .env and fill in
# Never commit real keys.

# LLM provider: groq | openai | gemini | mock
LLM_PROVIDER=groq
# Generator models (read from config, not hardcoded in logic)
# Leave blank for tested defaults. On 404 model_not_found (providers retire IDs),
# run: uv run python scripts/check_models.py and paste a live ID here.
AGENT_MODEL=
CHEAP_MODEL=
JUDGE_PROVIDER=mock
JUDGE_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Search
TAVILY_API_KEY=
# Budgets / run config
TEMPERATURE=0.0
SEED=42
# Max output tokens per LLM request. Lower this if you see
# "Request too large ... OTPM" 429 errors (free tiers cap this, e.g. 1000).
LLM_MAX_TOKENS=1000
# Seconds before one LLM HTTP request gives up (retried with backoff after).
LLM_TIMEOUT_S=30
# Researcher threads for the multi-agent pipeline (sub-questions are independent).
RESEARCH_WORKERS=3
# Abandon one hung researcher after this many seconds; the run continues partial.
RESEARCHER_TIMEOUT_S=240
# Public-demo guard: max runs per session id (Space env: keep low, quota is yours).
SESSION_CAP=5
# Worst case ≈ planner 1 + 5 sub-questions × 6 researcher iters + writer + critic.
# Keep headroom above 33 so a full 5-question plan can finish + revise once.
MAX_LLM_CALLS=40
MAX_TOOL_CALLS=30
MAX_TOKENS=60000
MAX_WALL_SECONDS=600
MAX_REVISIONS=2
CACHE_ENABLED=true
CACHE_DB=./.cache/deepbrief.sqlite
TRACE_DIR=./traces
PROMPT_VERSION=v1
